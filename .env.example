# Copy to .env and fill in. Never commit .env.
# Ring Developer Console -> your app
CLIENT_ID=
CLIENT_SECRET=
HMAC_SIGNATURE_KEY=
# Ring Developer Console -> Playground -> Generate token (expires after 30 minutes)
OAUTH_TOKEN=

# Family alerts (optional; without these, alerts are only logged). Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Household (optional)
PARENT_NAME=Mom
FAMILY_NAME=Ade
TIMEZONE=America/Los_Angeles
# Minutes before "package still outside" fires. Use 2 for live demos.
PACKAGE_ALERT_MINUTES=180
