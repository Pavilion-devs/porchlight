# Porchlight settings. Copy to .env (`make setup` does this) and fill in. Never commit .env.

# --- Ring (required for the live doorbell) --------------------------------------------------
# Ring Developer Console -> your app
CLIENT_ID=
CLIENT_SECRET=
HMAC_SIGNATURE_KEY=
# Ring Developer Console -> Playground -> Generate token. Expires after 30 minutes;
# paste a new one here any time, the backend re-reads it without a restart.
OAUTH_TOKEN=

# --- Family alerts via Telegram (optional; without these, alerts are only logged) ----------
# Make a bot with @BotFather (/newbot), paste its token, message the bot, then run `make telegram`
# to fill in TELEGRAM_CHAT_ID automatically.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- The household (optional) -----------------------------------------------------------------
PARENT_NAME=Mom
FAMILY_NAME=Ade
TIMEZONE=America/Los_Angeles
# Minutes before "package still outside" fires. Use 2 for live demos.
PACKAGE_ALERT_MINUTES=180

# --- Advanced (optional; defaults shown) --------------------------------------------------------
# AWS credentials come from `aws login` / `aws configure`, not from this file.
# AWS_REGION=us-east-1
# VISION_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AGENT_MODEL=us.anthropic.claude-sonnet-4-6
# USE_AGENT=true          # false = template alerts, no Strands agent
# WATCHER_ENABLED=true    # false = don't connect to the Ring stream
# RESIDENT_DESCRIPTION=an older woman in her late 70s with short grey hair
